# Release signing: copy this file to keystore.properties in the repository root (git-ignored, never commit it)
# and fill in the upload key. storeFile is a path to the .jks/.keystore file, absolute or relative to the
# repository root; storePassword and keyPassword are the store and key passwords, keyAlias the key's alias.
# Without keystore.properties, assembleRelease/bundleRelease fail; debug builds always use the local debug key.
storeFile=/docs/assets/keys/upload.jks
storePassword=change-me
keyAlias=audiobook
keyPassword=change-me
