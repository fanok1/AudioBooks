<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/focusable"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="@dimen/text_margin_book_description"
    tools:background="@color/colorBackgraund"
    tools:viewBindingIgnore="true">

    <RadioButton
        android:id="@+id/radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="@dimen/text_margin_book_description"
        android:button="@null"
        android:drawableStart="@drawable/radio_select"
        android:visibility="gone" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/colorPrimaryText"
        android:textSize="@dimen/titleSize"
        tools:text="05-22" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/text_margin"
        android:textColor="?attr/subTextColor"
        android:textSize="@dimen/titleSize"
        tools:text="14:05" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/is_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/text_margin_book_description"
            android:src="@drawable/ic_is_check"
            tools:ignore="ContentDescription" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="@dimen/text_margin_book_description" />

        <com.github.lzyzsd.circleprogress.DonutProgress
            android:id="@+id/download_progress"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/text_margin_book_description"
            android:contentDescription="@string/download_chapter_progress"
            android:visibility="gone"
            custom:donut_finished_color="@color/colorAcentPopupWindow"
            custom:donut_finished_stroke_width="2.5dp"
            custom:donut_max="100"
            custom:donut_progress="40"
            custom:donut_show_text="false"
            custom:donut_unfinished_color="#40909090"
            custom:donut_unfinished_stroke_width="2.5dp"
            tools:visibility="visible" />

    </RelativeLayout>

</LinearLayout>