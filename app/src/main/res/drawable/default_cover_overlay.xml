<?xml version="1.0" encoding="utf-8"?>
<!-- Spine, frame and emblem of the default cover for books whose own cover cannot be loaded; DefaultCover lays
     them over one of its muted gradients. 2:3 like the big list's 100x150dp slot (the list's 80x115dp is close
     to it); a vector, so the full-screen view stays sharp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="150dp"
    android:viewportWidth="200"
    android:viewportHeight="300">

    <!-- spine -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.24"
        android:pathData="M0,0h14v300h-14z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.14"
        android:pathData="M14,0h1.5v300h-1.5z" />
    <path android:pathData="M15.5,0h16v300h-16z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="15.5"
                android:startY="0"
                android:endX="31.5"
                android:endY="0"
                android:startColor="#29000000"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- frame -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.2"
        android:strokeWidth="1.5"
        android:pathData="M42,22h128a12,12 0 0,1 12,12v232a12,12 0 0,1 -12,12h-128a12,12 0 0,1 -12,-12v-232a12,12 0 0,1 12,-12z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.3"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M86,50h40" />

    <!-- medallion with headphones -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.08"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.18"
        android:strokeWidth="1.5"
        android:pathData="M106,84a44,44 0 1,1 0,88a44,44 0 1,1 0,-88z" />
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="76"
        android:translateY="98">
        <path
            android:fillColor="#EEF2F6"
            android:fillAlpha="0.9"
            android:pathData="M12,3C7.03,3 3,7.03 3,12v7c0,1.1 0.9,2 2,2h1c1.1,0 2,-0.9 2,-2v-4c0,-1.1 -0.9,-2 -2,-2H5v-1c0,-3.87 3.13,-7 7,-7s7,3.13 7,7v1h-1c-1.1,0 -2,0.9 -2,2v4c0,1.1 0.9,2 2,2h1c1.1,0 2,-0.9 2,-2v-7c0,-4.97 -4.03,-9 -9,-9z" />
    </group>

    <!-- title and author lines -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.32"
        android:pathData="M62,206h88a4,4 0 0,1 0,8h-88a4,4 0 0,1 0,-8z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.18"
        android:pathData="M79,226h54a3,3 0 0,1 0,6h-54a3,3 0 0,1 0,-6z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.3"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M96,256h20" />
</vector>
