<?xml version="1.0" encoding="utf-8"?>
<!-- The outlined pill that groups the "all direct" / "all through the proxy" buttons of the sources dialog. A fixed
     mid-grey at 30 %: visible on the light, the dark and the black background alike. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1dp"
        android:color="#4D808080" />
    <corners android:radius="20dp" />
</shape>
