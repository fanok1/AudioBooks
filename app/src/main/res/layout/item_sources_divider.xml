<?xml version="1.0" encoding="utf-8"?>
<!-- The row between the active and the inactive sources of the sources dialog: "АКТИВНЫ 10 / 13", an accent line, and
     the stepper that moves the boundary by one. Not draggable; only its buttons take focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/sourcesDividerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        tools:text="Активны 10 / 13" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:alpha="0.5"
        android:background="?attr/colorAccent" />

    <ImageButton
        android:id="@+id/sourcesLess"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sources_less"
        android:padding="5dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_minus_circle_outline"
        app:tint="?android:attr/textColorSecondary" />

    <ImageButton
        android:id="@+id/sourcesMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sources_more"
        android:padding="5dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_plus_circle_outline"
        app:tint="?android:attr/textColorSecondary" />
</LinearLayout>
