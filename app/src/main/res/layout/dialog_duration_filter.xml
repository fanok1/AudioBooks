<?xml version="1.0" encoding="utf-8"?>
<!-- The duration filter: ready-made ranges in a dropdown over a two-thumb slider on a non-linear scale
     (ListingFilters.Duration.STOPS); a preset moves the thumbs, moved thumbs show the matching preset. The
     slider's negative margins cancel its track inset, so the track lines up with the dropdown; clipToPadding off
     keeps its end thumbs whole where they reach into the side padding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp"
    android:paddingEnd="24dp"
    android:theme="@style/ThemeOverlay.App.DialogAccent">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/durationPresetLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/duration_presets">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/durationPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="false"
            android:inputType="none"
            tools:text="1–2 ч" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/duration_range"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/durationRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorAccent"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="от 1 ч до 2 ч" />
    </LinearLayout>

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/durationSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="17"
        app:tickVisible="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/duration_scale_start"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duration_unbounded"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
