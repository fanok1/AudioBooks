<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/recycler_item_height"
    android:background="?attr/backgroundItem"
    android:orientation="horizontal"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:id="@+id/contentConteiner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:selectableItemBackground"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/recycler_item_image_width"
                android:layout_height="match_parent"
                android:contentDescription="@string/book_cover"
                tools:srcCompat="@tools:sample/avatars[2]" />

            <com.github.lzyzsd.circleprogress.DonutProgress
                android:id="@+id/donutProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="@dimen/recycler_item_image_width"
                android:layout_height="@dimen/recycler_item_image_width"
                android:layout_centerInParent="true"
                android:visibility="gone"
                custom:donut_finished_color="@color/colorAcentPopupWindow"
                custom:donut_max="100"
                custom:donut_progress="14"
                custom:donut_finished_stroke_width="4dp"
                custom:donut_show_text="false"
                custom:donut_unfinished_color="@android:color/transparent"
                custom:donut_unfinished_stroke_width="4dp" />

            <!-- the percent and its label, one block centred in the ring's hole; shown with the ring -->
            <LinearLayout
                android:id="@+id/listened"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/listenedPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/colorAcentPopupWindow"
                    android:textSize="16sp"
                    tools:text="85%" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/listened_label"
                    android:textColor="@color/colorAcentPopupWindow"
                    android:textSize="9sp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/recycler_item_textmargin"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                tools:ignore="UselessParent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/recycler_item_textmargin">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/top_right_icons"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="?attr/colorPrimaryText"
                        android:textSize="@dimen/books_recyle_item_title_size"
                        tools:text="Зеланд Вадим - Жрица Итфат" />

                    <LinearLayout
                        android:id="@+id/top_right_icons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal"
                        tools:ignore="UseCompoundDrawables">

                        <TextView
                            android:id="@+id/source"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/subTextColor"
                            android:textSize="@dimen/subTextSize"
                            tools:text="Книга в ухе" />

                        <ImageView
                            android:id="@+id/is_download"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/text_margin_book_description"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/download_state_full" />
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/genre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/recycler_item_textmargin"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?attr/hrefColor"
                        tools:ignore="NestedWeights"
                        tools:text="ЭЗОТЕРИКА" />

                    <TextView
                        android:id="@+id/reting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/recycler_item_textmargin"

                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?attr/subTextColor"
                        android:textSize="@dimen/subTextSize"
                        tools:text="+7" />

                    <TextView
                        android:id="@+id/coments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/recycler_item_textmargin"
                        android:drawableStart="@drawable/ic_coments"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?attr/subTextColor"
                        android:textSize="@dimen/subTextSize"
                        tools:text="5" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/time"
                            android:layout_gravity="bottom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_clock"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/subTextColor"
                            android:textSize="@dimen/subTextSize"
                            tools:text="13 часов 15 минут" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/series"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/recycler_item_textmargin"
                                
                                android:gravity="center_vertical|end"
                                android:maxLines="2"
                                android:textColor="?attr/hrefColor"
                                android:textSize="@dimen/subTextSize"
                                tools:text="Темная башня" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/artist"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_artist"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/hrefColor"
                            android:textSize="@dimen/subTextSize"
                            tools:text="Кинг Стивен" />

                        <TextView
                            android:id="@+id/autor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/recycler_item_textmargin"
                            android:drawableStart="@drawable/ic_autor"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/hrefColor"
                            android:textSize="@dimen/subTextSize"
                            tools:text="Кинг Стивен" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>