<?xml version="1.0" encoding="utf-8"?>
<!-- The "Прокси" dialog (ProxyDialogFragment): three modes with a caption each; the automatic mode adds the search
     status, a progress bar while searching, "Найти заново" and a note. Theme colors only, so it follows every theme. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp"
        android:theme="@style/ThemeOverlay.App.DialogAccent">

        <RadioGroup
            android:id="@+id/proxyModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/proxyModeOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/proxy_mode_off"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/proxyModeOffCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp"
                android:text="@string/proxy_mode_off_caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/proxyModeBuiltin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/proxy_mode_builtin"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/proxyModeBuiltinCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp"
                android:text="@string/proxy_mode_builtin_caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/proxyModeAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/proxy_mode_auto"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/proxyModeAutoCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="@string/proxy_mode_auto_caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/proxyAutoPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/proxyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                tools:text="Работает: 1.2.3.4:8080 · 420 мс" />

            <ProgressBar
                android:id="@+id/proxyProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                tools:progress="40"
                tools:visibility="visible" />

            <Button
                android:id="@+id/proxyRescan"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp"
                android:text="@string/proxy_rescan" />

            <TextView
                android:id="@+id/proxyNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/proxy_note"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
