<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: same exclusions as backup_rules.xml for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.fanok.books_preferences.xml" />
        <exclude domain="sharedpref" path="Parental Control.xml" />
        <exclude domain="sharedpref" path="STORAGE.xml" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.fanok.books_preferences.xml" />
        <exclude domain="sharedpref" path="Parental Control.xml" />
        <exclude domain="sharedpref" path="STORAGE.xml" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
